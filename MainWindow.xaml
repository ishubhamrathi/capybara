<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="CapyBara.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CapyBara.Controls"
    Title="CapyBara">
    <Grid x:Name="RootGrid" Background="#202124">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="Tab"
                Modifiers="Control"
                Invoked="NewTabKeyboardAccelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:BrowserToolbar x:Name="BrowserToolbar" Grid.Row="0" />
        <Grid
            x:Name="BrowserHost"
            Grid.Row="1"
            Background="#202124" />
    </Grid>
</Window>
