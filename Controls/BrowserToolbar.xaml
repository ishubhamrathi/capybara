<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="CapyBara.Controls.BrowserToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Padding="10,5,0,5" ColumnSpacing="8" Background="#202124">
        <Grid.Resources>
            <SolidColorBrush x:Key="ToolbarBackground" Color="#202124" />
            <SolidColorBrush x:Key="AddressBackground" Color="#2B2D31" />
            <SolidColorBrush x:Key="AddressForeground" Color="#E8EAED" />
            <SolidColorBrush x:Key="PrimaryText" Color="#E8EAED" />
            <SolidColorBrush x:Key="SecondaryText" Color="#A4A8B0" />
            <SolidColorBrush x:Key="TabActiveBackground" Color="#34363B" />
            <SolidColorBrush x:Key="TabInactiveBackground" Color="Transparent" />
            <SolidColorBrush x:Key="TabHoverBackground" Color="#303238" />
            <SolidColorBrush x:Key="ToolbarHover" Color="#35373D" />

            <Style x:Key="ChromeButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="MinWidth" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="TabButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="32" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource PrimaryText}" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="2*" MinWidth="180" MaxWidth="480" />
            <ColumnDefinition Width="4*" MinWidth="240" />
            <ColumnDefinition Width="*" MinWidth="20" />
            <ColumnDefinition Width="138" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <Button Style="{StaticResource ChromeButtonStyle}" Content="&#xE80F;" ToolTipService.ToolTip="Home" Click="HomeButton_Click" />
            <Button x:Name="BackButton" Style="{StaticResource ChromeButtonStyle}" Content="&#xE72B;" ToolTipService.ToolTip="Back" Click="BackButton_Click" />
            <Button x:Name="ForwardButton" Style="{StaticResource ChromeButtonStyle}" Content="&#xE72A;" ToolTipService.ToolTip="Forward" Click="ForwardButton_Click" />
            <Button x:Name="ReloadButton" Style="{StaticResource ChromeButtonStyle}" Content="&#xE72C;" ToolTipService.ToolTip="Reload" Click="ReloadButton_Click" />
        </StackPanel>

        <Border Grid.Column="1" Height="36" VerticalAlignment="Center" Background="{StaticResource AddressBackground}" CornerRadius="9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="SearchEngineButton"
                    Grid.Column="0"
                    Width="48"
                    Height="32"
                    Margin="8,0,4,0"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="Choose search engine">
                    <Button.Flyout>
                        <MenuFlyout x:Name="SearchEngineMenu" />
                    </Button.Flyout>
                    <Grid ColumnSpacing="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="16" Height="16">
                            <FontIcon
                                x:Name="SearchEngineFallbackIcon"
                                Glyph="&#xE721;"
                                FontSize="14"
                                Foreground="{StaticResource SecondaryText}"
                                VerticalAlignment="Center" />
                            <Image
                                x:Name="SearchEngineIcon"
                                Width="16"
                                Height="16"
                                Stretch="Uniform"
                                Visibility="Collapsed"
                                ImageFailed="SearchEngineIcon_ImageFailed" />
                        </Grid>
                        <FontIcon Grid.Column="1" Glyph="&#xE70D;" FontSize="8" Foreground="{StaticResource SecondaryText}" />
                    </Grid>
                </Button>
                <AutoSuggestBox
                    x:Name="AddressBar"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0,3,10,3"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    FontSize="14"
                    Foreground="{StaticResource AddressForeground}"
                    PlaceholderText="Search or enter address"
                    RequestedTheme="Dark"
                    QueryIcon="{x:Null}"
                    DisplayMemberPath="Text"
                    TextMemberPath="Text"
                    TextChanged="AddressBar_TextChanged"
                    QuerySubmitted="AddressBar_QuerySubmitted"
                    GotFocus="AddressBar_GotFocus"
                    LostFocus="AddressBar_LostFocus" />
            </Grid>
        </Border>

        <Grid
            x:Name="TabContainer"
            Grid.Column="2"
            ColumnSpacing="3"
            MinWidth="240"
            SizeChanged="TabContainer_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="TabViewport" Grid.Column="0" HorizontalAlignment="Left">
                <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" />
            </Grid>
            <Button
                x:Name="NewTabButton"
                Grid.Column="1"
                Style="{StaticResource ChromeButtonStyle}"
                Content="&#xE710;"
                ToolTipService.ToolTip="New tab"
                Click="NewTabButton_Click" />
        </Grid>

        <Border x:Name="DragContainer" Grid.Column="3" Background="Transparent" />

        <Grid x:Name="CaptionContainer" Grid.Column="4" Width="138" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="46" />
            </Grid.ColumnDefinitions>
            <Button x:Name="MinimizeButton" Grid.Column="0" Style="{StaticResource ChromeButtonStyle}" Content="&#xE921;" FontSize="11" Click="MinimizeButton_Click" ToolTipService.ToolTip="Minimize" />
            <Button x:Name="MaximizeButton" Grid.Column="1" Style="{StaticResource ChromeButtonStyle}" Content="&#xE922;" FontSize="11" Click="MaximizeButton_Click" ToolTipService.ToolTip="Maximize" />
            <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource ChromeButtonStyle}" Content="&#xE8BB;" FontSize="11" Click="CloseButton_Click" ToolTipService.ToolTip="Close" />
        </Grid>
    </Grid>
</UserControl>
